{
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "presencevision-rho.vercel.app"
        }
      ],
      "destination": "https://presencevision.com/:path*",
      "permanent": true
    }
  ]
}
